# Copy to ai-service/.env and fill in. NEVER commit the real .env.
#
# This Mac (Apple Silicon, 16 GB, no NVIDIA) cannot run CUDA VTON models.
# Generation belongs on a separate NVIDIA GPU (or a temporary Colab GPU).
#
# Providers (frontend never chooses the model):
#   huggingface_idm_vton   IDM-VTON Hugging Face ZeroGPU Space
#   huggingface            alias of huggingface_idm_vton
#   huggingface_catvton    CatVTON Hugging Face ZeroGPU Space (same quota pool)
#   catvton                CatVTON on VTON_LOCAL_URL (POST /generate)
#   local                  alias of catvton
#   local_server           IDM-VTON on VTON_LOCAL_URL (POST /tryon)
#   none                   honest failure — never a fake overlay
#   replicate              paid — do not enable unless explicitly approved
# Local-first on this Mac. No Hugging Face ZeroGPU, no paid API.
VTON_PROVIDER=local
# Optional NVIDIA CatVTON server only — leave empty so quota errors cannot appear.
VTON_FALLBACK_PROVIDER=

# Free Hugging Face token — used only for Spaces. Never put this in the frontend.
# HF_TOKEN=hf_...

# CatVTON / IDM-VTON GPU box (not this Mac). Leave unset on Apple Silicon.
# VTON_LOCAL_URL=http://192.168.1.50:8010
# VTON_LOCAL_MODEL=catvton

# Denoise steps for IDM-VTON. The yisol/IDM-VTON Space requires >= 20.
# TRYON_STEPS=30

# Paid path — leave unset unless you approve it
# REPLICATE_API_TOKEN=
