<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ph.ptri.ai-color</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/XAMPP/xamppfiles/htdocs/ptri-AI-color-analysis/ai-service/.venv/bin/uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8001</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Applications/XAMPP/xamppfiles/htdocs/ptri-AI-color-analysis/ai-service</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>StandardOutPath</key>
  <string>/tmp/ptri-ai.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ptri-ai.log</string>
</dict>
</plist>
